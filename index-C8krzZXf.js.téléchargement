  :host {
    --cg-bg: #FFFFFF;
    --cg-cream: #F1EFE8;
    --cg-line: rgba(36,56,184,0.25);
    --cg-line-soft: rgba(36,56,184,0.15);
    --cg-ink: #20255C;
    --cg-ink-soft: #5A5F96;
    --cg-ink-mute: #5A5F96;
    --cg-accent: #FF4FA3;
    --cg-primary: #20255C;
    --cg-primary-hover: #000000;
    --cg-overlay: rgba(20, 16, 6, 0.42);
    --cg-font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;

    position: fixed;
    inset: 0;
    z-index: 2147483647;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: max(16px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right))
      max(16px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));
    overflow-y: auto;
    font-family: var(--cg-font);
    color: var(--cg-ink);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .overlay {
    position: fixed;
    inset: 0;
    background: var(--cg-overlay);
    animation: cg-fade 0.22s ease both;
  }

  @keyframes cg-fade { from { opacity: 0 } }

  @keyframes cg-pop {
    from { opacity: 0; transform: translateY(16px) scale(0.985); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .card {
    position: relative;
    width: 100%;
    max-width: 380px;
    margin: auto;
    background: var(--cg-bg);
    border: 1px solid var(--cg-line);
    border-radius: 24px;
    box-shadow:
      0 1px 1px rgba(28, 18, 8, 0.04),
      0 30px 64px -34px rgba(28, 18, 8, 0.55),
      0 8px 22px -14px rgba(20, 16, 6, 0.20);
    animation: cg-pop 0.30s cubic-bezier(0.22, 1, 0.36, 1) both;
    overflow: hidden;
  }

  .body { padding: 28px 24px 22px; text-align: center; }

  .icon {
    width: 52px; height: 52px; margin: 0 auto 14px;
    border-radius: 15px; background: var(--cg-accent);
    display: flex; align-items: center; justify-content: center;
  }
  .icon svg { display: block; }

  .headline {
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--cg-ink);
    text-wrap: balance;
    margin-bottom: 7px;
  }

  .sub {
    font-size: 14px;
    font-weight: 500;
    color: var(--cg-ink-soft);
    text-wrap: pretty;
    margin-bottom: 20px;
  }

  .plans {
    border: 1px solid var(--cg-line);
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 18px;
    text-align: start;
  }

  /* The whole row is the tap target (≥46px) — the price is the affordance. */
  .plan-row {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 46px;
    padding: 8px 8px 8px 15px;
    font-size: 13.5px;
    color: var(--cg-ink);
    text-decoration: none;
    transition: background 0.15s;
  }
  .plan-row:hover { background: var(--cg-cream); }
  .plan-row + .plan-row { border-top: 1px solid var(--cg-line-soft); }

  .plan-name  { font-weight: 700; min-width: 52px; }
  .plan-credits { color: var(--cg-ink-mute); flex: 1; }

  .plan-price {
    flex-shrink: 0;
    padding: 7px 13px;
    font-size: 13px;
    font-weight: 700;
    color: var(--cg-ink);
    background: var(--cg-cream);
    border: 1px solid var(--cg-line);
    border-radius: 999px;
  }

  .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    min-height: 48px;
    padding: 12px 16px;
    font-size: 14.5px;
    font-weight: 700;
    font-family: var(--cg-font);
    border: none;
    border-radius: 999px;
    cursor: pointer;
    text-decoration: none;
    color: #fff;
    background: var(--cg-primary);
    transition: background 0.16s;
  }

  .btn:hover { background: var(--cg-primary-hover); }

  .btn-outline {
    background: transparent;
    color: var(--cg-ink);
    border: 1.5px solid var(--cg-line);
    margin-top: 8px;
  }

  .btn-outline:hover { background: var(--cg-cream); border-color: var(--cg-ink); }

  .note {
    margin-top: 14px;
    font-size: 12px;
    color: var(--cg-ink-mute);
  }

  .close-btn {
    position: absolute;
    top: 13px;
    inset-inline-end: 13px;
    width: 30px;
    height: 30px;
    border: 1px solid var(--cg-line);
    background: var(--cg-cream);
    cursor: pointer;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cg-ink-mute);
    font-size: 15px;
    line-height: 1;
    padding: 0;
    transition: background 0.18s, color 0.18s, border-color 0.18s;
  }
  /* 44px+ hit area without changing the visual size. */
  .close-btn::after { content: ''; position: absolute; inset: -9px; }
  .close-btn:hover { background: var(--cg-ink); color: #fff; border-color: var(--cg-ink); }

  .footer {
    text-align: center;
    padding: 12px 24px;
    border-top: 1px solid var(--cg-line-soft);
    font-size: 11.5px;
    color: var(--cg-ink-mute);
    font-weight: 500;
  }

  .footer span { color: var(--cg-ink); font-weight: 700; }

  @media (max-width: 480px) {
    .card { max-width: 420px; }
    .body { padding: 24px 18px 18px; }
  }
